        {
          "name": "4. Assign INACTIVE helper -> 400",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assistance-requests/{{overlapId}}/assign/{{inactiveHelperId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
