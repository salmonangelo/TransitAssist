            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"pickupPoint\": \"Main Gate\",\n  \"destination\": \"Library\",\n  \"tripDate\": \"{{tripDate}}\",\n  \"tripTime\": \"10:00\",\n  \"assistanceType\": \"WHEELCHAIR\",\n  \"additionalNotes\": \"Created from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('requestId', pm.response.json().id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pick a random future day so re-running the collection never collides with older bookings",
                  "const d = new Date(Date.now() + (30 + Math.floor(Math.random() * 3000)) * 86400000);",
                  "pm.collectionVariables.set('tripDate', d.toISOString().slice(0, 10));"
                ]
              }
            }
          ]
        },
