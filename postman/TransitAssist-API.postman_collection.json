    {
      "name": "4. Negative Tests (run AFTER folder 3)",
      "item": [
        {
          "name": "Setup: create request 30 min after the assigned one",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
