              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"pickupPoint\": \"Admin Block\",\n  \"destination\": \"Auditorium\",\n  \"tripDate\": \"{{tripDate}}\",\n  \"tripTime\": \"10:30\",\n  \"assistanceType\": \"WHEELCHAIR\",\n  \"additionalNotes\": \"Created from Postman\"\n}",
