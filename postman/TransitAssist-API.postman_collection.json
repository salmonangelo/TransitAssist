                  "pm.collectionVariables.set('overlapId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1. Assign SAME helper to overlapping request -> 409",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assistance-requests/{{overlapId}}/assign/3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assistance-requests",
                "{{overlapId}}",
                "assign",
                "3"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 409', function () { pm.response.to.have.status(409); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Message mentions: already assigned to another request', function () { pm.expect(pm.response.json().message).to.include(\"already assigned to another request\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Cancel a COMPLETED request -> 400",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assistance-requests/{{requestId}}/cancel",
              "host": [
