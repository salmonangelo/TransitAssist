            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Message mentions: Completed requests cannot be cancelled', function () { pm.expect(pm.response.json().message).to.include(\"Completed requests cannot be cancelled\"); });"
                ]
              }
            }
          ]
